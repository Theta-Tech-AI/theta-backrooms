    {
      "parameters": {
        "jsCode": "// Function node code\n// Returns a single item with .json.xml containing all messages as one XML string\n\n// items is provided by n8n (array of input items)\nlet xml = '<messages>';\n\nfunction protectCdata(str) {\n  const s = (str === undefined || str === null) ? '' : String(str);\n  return s.replace(/]]>/g, ']]]]><![CDATA[>');\n}\n\nfor (const it of items) {\n  const m = it.json || {};\n  const author = m.author || {};\n\n  // fields\n  const timestamp = m.timestamp || m.created_at || '';\n\n  // content as string + protected for CDATA\n  const content = (m.content === undefined || m.content === null) ? '' : String(m.content);\n  const safeContent = protectCdata(content);\n\n  // decide username\n  const rawUsername = author.username || '';\n  let chosenUsername = rawUsername;\n\n  if (rawUsername === 'Theta-Bot') {\n    // Try to extract personality name from leading \"**Name:**\" pattern\n    // e.g., \"**Musestra:** hello\"\n    const match = content.match(/^\\s*\\*\\*([^:]+):\\*\\*/);\n    if (match && match[1]) {\n      chosenUsername = match[1].trim();\n    }\n  }\n\n  const safeUsername = protectCdata(chosenUsername);\n\n  // build xml for this message\n  xml += '\\n  <message>';\n  xml += `\\n    <timestamp>${timestamp}</timestamp>`;\n  xml += `\\n    <username><![CDATA[${safeUsername}]]></username>`;\n  xml += `\\n    <content><![CDATA[${safeContent}]]></content>`;\n  xml += '\\n  </message>';\n}\n\nxml += '\\n</messages>';\n\nconst contentOut = xml;\n\nreturn [{ json: { content: contentOut } }];\n"
      },
