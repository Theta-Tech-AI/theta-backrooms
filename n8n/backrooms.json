    {
      "parameters": {
        "jsCode": "// Function node code\n// Returns a single item with .json.xml containing all messages as one XML string\n\n// items is provided by n8n (array of input items)\nlet xml = '<messages> ';\n\nfor (const it of items) {\n  const m = it.json || {};\n\n  // pull fields (fallbacks if different shape)\n  const timestamp = m.timestamp || m.created_at || '';\n  const content = (m.content === undefined || m.content === null) ? '' : String(m.content);\n\n  // Protect CDATA end marker if present\n  const safeContent = content.replace(/]]>/g, ']]]]><![CDATA[>');\n\n  xml += '  <message>';\n  xml += `    <timestamp>${timestamp}</timestamp> `;\n  xml += `    <content><![CDATA[${safeContent}]]></content> `;\n  xml += '  </message>\\n';\n}\n\nxml += '</messages>';\nconst content = xml;\n\nreturn [{ json: { content } }];\n"
      },
